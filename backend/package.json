{
  "name": "backend",
  "version": "1.0.0",
  "scripts": {
    "build": "babel src --out-dir dist --extensions \".ts\"",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec babel-node src/server.ts --extensions \".ts\"",
    "typecheck": "tsc --noEmit",
    "sync:db": "babel-node src/config/database.ts --extensions .ts",
    "migrate": "ts-node src/config/migrate.ts"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.18.2",
    "react-router-dom": "^7.13.1",
    "redis": "^5.8.3",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "socket.io": "^4.8.1",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/node": "^7.28.0",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.9.0",
    "@types/redis": "^4.0.11",
    "@types/sequelize": "^6.12.0",
    "@types/socket.io": "^3.0.2",
    "@types/umzug": "^3.0.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.9.3"
  }
}
